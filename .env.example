# ==============================================================================
# WireForge 部署环境变量配置模版
# 部署时复制此文件为 .env 并按实际网络环境修改参数
# ==============================================================================

# MySQL 数据库配置
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=wireforge_root_2026
MYSQL_DATABASE=wireforge

# 后端服务端口 (容器映射端口)
BACKEND_PORT=8090

# 前端 Web 访问端口 (容器映射端口)
FRONTEND_PORT=80

# Cross-origin deployments: exact frontend origins, separated by commas. Same-origin needs no CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# In-memory session cache capacity; valid sessions remain in the database after eviction.
WIREFORGE_SESSION_CACHE_MAX_SIZE=10000

# 时区配置
TZ=Asia/Shanghai

# Static HTML generation (optional dedicated coding model; empty uses AI_MODEL)
AI_BASE_URL=https://deepgpt.aiduet.app
AI_PROTOCOL=responses
AI_API_KEY=
AI_MODEL=gpt-6.1-sol
WIREFORGE_AI_DIRECT_HTML=true
AI_HTML_MODEL=
AI_HTML_IMAGE_MAX_EDGE=2400
AI_HTML_REASONING_EFFORT=high
AI_HTML_TIMEOUT_SECONDS=600
AI_ARTWORK_ENABLED=false
AI_ARTWORK_MODEL=gpt-image-2
AI_ARTWORK_MAX_PER_PAGE=12
# Local render checks gate AI repair; clean pages skip the extra model call.
WIREFORGE_AI_REPAIR=true
WIREFORGE_AI_REPAIR_ROUNDS=1
