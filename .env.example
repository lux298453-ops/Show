# ==============================================================================
# WireForge 部署环境变量配置模版
# 部署时复制此文件为 .env 并按实际网络环境修改参数
# ==============================================================================

# MySQL 数据库配置
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=wireforge_root_2026
MYSQL_DATABASE=wireforge

# 后端服务端口 (容器映射端口)
BACKEND_PORT=8090

# 前端 Web 访问端口 (容器映射端口)
FRONTEND_PORT=80

# 时区配置
TZ=Asia/Shanghai
